{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biologix-decision-board",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/worker.js",
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BIOLOGIX_INTEL",
        "class_name": "BiologixIntelStore"
      }
    ]
  },
  "exports": {
    "BiologixIntelStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/ovo-labs",
      "/ovo-labs/*",
      "/ovo-labs-porcelain",
      "/ovo-labs-porcelain/*",
      "/datum-peptides",
      "/datum-peptides/*",
      "/third-standard",
      "/third-standard/*",
      "/api/biologix-intel",
      "/api/biologix-intel/*"
    ],
    "binding": "ASSETS"
  }
}
